# Set these in your hosting provider's secret/environment settings.
DATABASE_PATH=/app/data/workspace.db
CORS_ORIGINS=https://your-frontend-domain.example
# Safety review: the secret key YOU type into admin.html. Make it long (16+ characters) and private.
SAFETY_ADMIN_PIN=
SAFETY_ADMIN_TOKEN=
SAFETY_DATABASE_PATH=/app/data/safety.db
# AI companies — add one or more keys. Groq is tried first, then Gemini, OpenRouter, xAI.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
